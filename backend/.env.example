# Copia este archivo a .env para desarrollo local (go run ./cmd/api).
PORT=8080
DATABASE_URL=postgres://energy:energy@localhost:5432/energyai?sslmode=disable
DATA_DIR=./data
JWT_SECRET=dev-secret-change-me
JWT_TTL=12h
DEMO_EMAIL=demo@energyai.local
DEMO_PASSWORD=demo1234
DEMO_NAME=Operador Demo
CORS_ORIGINS=http://localhost:5173
ANALYSIS_STEP_DELAY_MS=450
BASELINE_DAYS=7
LOG_LEVEL=info

# IA generativa opcional: none | ollama | openai
# none   -> explicaciones por reglas (no requiere nada)
# ollama -> modelo local gratis (requiere Ollama + `ollama pull qwen2.5:7b`)
# openai -> cualquier API compatible con OpenAI (requiere LLM_API_KEY)
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT=90s
