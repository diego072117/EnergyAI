# Variables para docker compose. Copia a .env para cambiarlas.
# IA generativa: none (plantillas) | ollama (modelo local gratuito) | openai (API compatible, requiere LLM_API_KEY)
LLM_PROVIDER=none
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=
JWT_SECRET=change-me-in-production
DEMO_EMAIL=demo@energyai.local
DEMO_PASSWORD=demo1234
ANALYSIS_STEP_DELAY_MS=450
